@using System.Globalization
@inject AxiomSysPortal.SharedLocalizer SharedLocalizer
@{
	string lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
	bool isArabic = lang == "ar";
	string otherLang = isArabic ? "en" : "ar";
	string otherUrl = Context.Request.Path.Value!.Replace("/" + lang + "/", "/" + otherLang + "/");
}
<!DOCTYPE html>
<html lang="@lang" dir="@(isArabic ? "rtl" : "ltr")">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>
	@if (isArabic)
	{
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
	}
	else
	{
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
	}
	<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
</head>
<body>
	<nav class="navbar bg-light px-3 mb-3">
		<span class="navbar-brand">Axiom</span>
		<a class="btn btn-outline-secondary btn-sm" href="@otherUrl">@(isArabic ? "English" : "العربية")</a>
	</nav>

	<div class="container-fluid">
		@RenderBody()
	</div>

	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>